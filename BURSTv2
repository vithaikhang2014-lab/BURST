--==========================================================

        function API:CreateColorPicker(
            Text,
            Default,
            Callback
        )

            local CurrentColor =
                Default or
                Color3.fromRGB(
                    140,
                    85,
                    255
                )


            local H, S, V =
                CurrentColor:ToHSV()

            local Opened = false


            local Container = New("Frame", {
                Parent = Holder,

                Size = UDim2.new(1, 0, 0, 44),

                BackgroundColor3 =
                    Config.Theme.Tertiary,

                BorderSizePixel = 0,

                ClipsDescendants = true
            })

            Corner(Container, 10)


            local HeaderButton = New("TextButton", {
                Parent = Container,

                Size = UDim2.new(1, 0, 0, 44),

                BackgroundTransparency = 1,

                Text = "",

                AutoButtonColor = false
            })


            New("TextLabel", {
                Parent = HeaderButton,

                Position = UDim2.fromOffset(13, 0),

                Size = UDim2.new(1, -100, 1, 0),

                BackgroundTransparency = 1,

                Text = Text,

                Font = Enum.Font.GothamMedium,

                TextSize = 12,

                TextColor3 =
                    Config.Theme.Text,

                TextXAlignment =
                    Enum.TextXAlignment.Left
            })


            local Preview = New("Frame", {
                Parent = HeaderButton,

                AnchorPoint = Vector2.new(1, .5),

                Position = UDim2.new(1, -12, .5, 0),

                Size = UDim2.fromOffset(40, 24),

                BackgroundColor3 =
                    CurrentColor,

                BorderSizePixel = 0
            })

            Corner(Preview, 8)


--==========================================================
-- COLOR PICKER AREA
--==========================================================

            local Picker = New("Frame", {
                Parent = Container,

                Position = UDim2.fromOffset(10, 54),

                Size = UDim2.new(1, -20, 0, 175),

                BackgroundTransparency = 1
            })


-- SATURATION / VALUE
            local SV = New("ImageButton", {
                Parent = Picker,

                Position = UDim2.fromOffset(0, 0),

                Size = UDim2.new(1, -48, 0, 145),

                BackgroundColor3 =
                    Color3.fromHSV(H, 1, 1),

                BorderSizePixel = 0,

                AutoButtonColor = false,

                Image =
                    "rbxassetid://4155801252",

                ScaleType = Enum.ScaleType.Stretch
            })

            Corner(SV, 9)


-- WHITE → TRANSPARENT
            local WhiteGradient = New("UIGradient", {
                Parent = SV,

                Color = ColorSequence.new(
                    Color3.new(1,1,1),
                    Color3.new(1,1,1)
                ),

                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1)
                })
            })

            WhiteGradient.Rotation = 0


-- BLACK OVERLAY
            local Black = New("Frame", {
                Parent = SV,

                Size = UDim2.fromScale(1, 1),

                BackgroundColor3 =
                    Color3.new(0, 0, 0),

                BackgroundTransparency = 1,

                BorderSizePixel = 0
            })

            Corner(Black, 9)


            local BlackGradient = New("UIGradient", {
                Parent = Black,

                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(1, 0)
                }),

                Rotation = 90
            })


-- PICKER CURSOR
            local Cursor = New("Frame", {
                Parent = SV,

                AnchorPoint =
                    Vector2.new(.5, .5),

                Size = UDim2.fromOffset(14, 14),

                BackgroundColor3 =
                    Color3.new(1,1,1),

                BorderSizePixel = 0
            })

            Corner(Cursor, 20)

            New("UIStroke", {
                Parent = Cursor,

                Color = Color3.new(0,0,0),

                Thickness = 2
            })


--==========================================================
-- HUE BAR
--==========================================================

            local Hue = New("ImageButton", {
                Parent = Picker,

                AnchorPoint =
                    Vector2.new(1, 0),

                Position =
                    UDim2.new(1, 0, 0, 0),

                Size =
                    UDim2.fromOffset(32, 145),

                BackgroundColor3 =
                    Color3.new(1,1,1),

                BorderSizePixel = 0,

                AutoButtonColor = false
            })

            Corner(Hue, 9)


            local HueGradient = New("UIGradient", {
                Parent = Hue,

                Color = ColorSequence.new({

                    ColorSequenceKeypoint.new(
                        0,
                        Color3.fromHSV(0,1,1)
                    ),

                    ColorSequenceKeypoint.new(
                        .166,
                        Color3.fromHSV(.166,1,1)
                    ),

                    ColorSequenceKeypoint.new(
                        .333,
                        Color3.fromHSV(.333,1,1)
                    ),

                    ColorSequenceKeypoint.new(
                        .5,
                        Color3.fromHSV(.5,1,1)
                    ),

                    ColorSequenceKeypoint.new(
                        .666,
                        Color3.fromHSV(.666,1,1)
                    ),

                    ColorSequenceKeypoint.new(
                        .833,
                        Color3.fromHSV(.833,1,1)
                    ),

                    ColorSequenceKeypoint.new(
                        1,
                        Color3.fromHSV(1,1,1)
                    )

                }),

                Rotation = 90
            })


            local HueCursor = New("Frame", {
                Parent = Hue,

                AnchorPoint =
                    Vector2.new(.5,.5),

                Position =
                    UDim2.new(
                        .5,
                        0,
                        H,
                        0
                    ),

                Size = UDim2.fromOffset(38, 5),

                BackgroundColor3 =
                    Color3.new(1,1,1),

                BorderSizePixel = 0
            })

            Corner(HueCursor, 5)


--==========================================================
-- RGB DISPLAY
--==========================================================

            local RGBText = New("TextLabel", {
                Parent = Picker,

                Position = UDim2.new(0, 0, 0, 150),

                Size = UDim2.new(1, -48, 0, 22),

                BackgroundTransparency = 1,

                Text = "",

                Font = Enum.Font.GothamMedium,

                TextSize = 10,

                TextColor3 =
                    Config.Theme.SubText,

                TextXAlignment =
                    Enum.TextXAlignment.Left
            })


--==========================================================
-- COLOR UPDATE
--==========================================================

            local function UpdateColor()

                CurrentColor =
                    Color3.fromHSV(
                        H,
                        S,
                        V
                    )

                Preview.BackgroundColor3 =
                    CurrentColor

                SV.BackgroundColor3 =
                    Color3.fromHSV(
                        H,
                        1,
                        1
                    )

                Cursor.Position =
                    UDim2.new(
                        S,
                        0,
                        1 - V,
                        0
                    )

                HueCursor.Position =
                    UDim2.new(
                        .5,
                        0,
                        H,
                        0
                    )

                local R =
                    math.floor(
                        CurrentColor.R * 255
                    )

                local G =
                    math.floor(
                        CurrentColor.G * 255
                    )

                local B =
                    math.floor(
                        CurrentColor.B * 255
                    )

                RGBText.Text =
                    string.format(
                        "RGB  %d, %d, %d",
                        R,
                        G,
                        B
                    )

                if Callback then
                    task.spawn(
                        Callback,
                        CurrentColor
                    )
                end

            end


            UpdateColor()


--==========================================================
-- SV DRAG
--==========================================================

            local SVDragging = false


            local function UpdateSV(Input)

                local X =
                    math.clamp(
                        Input.Position.X -
                        SV.AbsolutePosition.X,

                        0,
                        SV.AbsoluteSize.X
                    )

                local Y =
                    math.clamp(
                        Input.Position.Y -
                        SV.AbsolutePosition.Y,

                        0,
                        SV.AbsoluteSize.Y
                    )

                S =
                    X /
                    SV.AbsoluteSize.X

                V =
                    1 -
                    (
                        Y /
                        SV.AbsoluteSize.Y
                    )

                UpdateColor()

            end


            SV.InputBegan:Connect(function(Input)

                if Input.UserInputType ==
                    Enum.UserInputType.MouseButton1
                then

                    SVDragging = true

                    UpdateSV(Input)

                end

            end)


            UserInputService.InputChanged:Connect(function(Input)

                if
                    SVDragging
                    and
                    Input.UserInputType ==
                        Enum.UserInputType.MouseMovement
                then

                    UpdateSV(Input)

                end

            end)


            UserInputService.InputEnded:Connect(function(Input)

                if Input.UserInputType ==
                    Enum.UserInputType.MouseButton1
                then

                    SVDragging = false

                end

            end)

--==========================================================
-- HUE DRAG
--==========================================================

            local HueDragging = false


            local function UpdateHue(Input)

                local Y =
                    math.clamp(
                        Input.Position.Y -
                        Hue.AbsolutePosition.Y,

                        0,
                        Hue.AbsoluteSize.Y
                    )

                H =
                    Y /
                    Hue.AbsoluteSize.Y

                UpdateColor()

            end


            Hue.InputBegan:Connect(function(Input)

                if Input.UserInputType ==
                    Enum.UserInputType.MouseButton1
                then

                    HueDragging = true

                    UpdateHue(Input)

                end

            end)


            UserInputService.InputChanged:Connect(function(Input)

                if
                    HueDragging
                    and
                    Input.UserInputType ==
                        Enum.UserInputType.MouseMovement
                then

                    UpdateHue(Input)

                end

            end)


            UserInputService.InputEnded:Connect(function(Input)

                if Input.UserInputType ==
                    Enum.UserInputType.MouseButton1
                then

                    HueDragging = false

                end

            end)

--==========================================================
-- OPEN COLOR PICKER
--==========================================================

            HeaderButton.MouseButton1Click:Connect(function()

                Opened = not Opened

                Tween(
                    Container,
                    .3,
                    {
                        Size =
                            Opened
                            and UDim2.new(
                                1,
                                0,
                                0,
                                240
                            )
                            or UDim2.new(
                                1,
                                0,
                                0,
                                44
                            )
                    }
                )

            end)


            return {

                Set = function(_, Value)

                    if typeof(Value) == "Color3" then

                        CurrentColor = Value

                        H, S, V =
                            Value:ToHSV()

                        UpdateColor()

                    end

                end,

                Get = function()

                    return CurrentColor

                end

            }

        end

        return API

    end

    return Tab

end

--==========================================================
-- PUBLIC API
--==========================================================

function Burst:SetToggleKey(Key)

    if typeof(Key) == "EnumItem"
        and Key.EnumType == Enum.KeyCode
    then

        Config.ToggleKey = Key

    end

end


function Burst:Open()
    OpenUI()
end


function Burst:Close()
    CloseUI()
end


function Burst:Toggle()
    ToggleUI()
end


function Burst:SetAccent(Color)

    if typeof(Color) ~= "Color3" then
        return
    end

    Config.Theme.Accent = Color

    AccentLine.BackgroundColor3 = Color

end


function Burst:Destroy()

    if ScreenGui then
        ScreenGui:Destroy()
    end

end

return Burst
