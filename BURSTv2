--==========================================================
-- OPEN / CLOSE
--==========================================================

local Visible = true
local Animating = false

local function OpenUI()

    if Visible or Animating then
        return
    end

    Animating = true

    Visible = true

    Main.Visible = true

    Scale.Scale = .82

    Tween(
        Scale,
        .45,
        {
            Scale = 1
        },
        Enum.EasingStyle.Back
    )

    task.wait(.42)

    Animating = false
end


local function CloseUI()

    if not Visible or Animating then
        return
    end

    Animating = true

    Tween(
        Scale,
        .1,
        {
            Scale = 1.025
        },
        Enum.EasingStyle.Quad
    )

    task.wait(.07)

    Tween(
        Scale,
        .28,
        {
            Scale = .82
        },
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.In
    )

    task.wait(.28)

    Main.Visible = false

    Scale.Scale = 1

    Visible = false

    Animating = false
end


local function ToggleUI()

    if Visible then
        CloseUI()
    else
        OpenUI()
    end
end

