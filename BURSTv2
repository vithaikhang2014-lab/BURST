                Corner(OptionButton, 7)


                OptionButton.MouseButton1Click:Connect(function()

                    Selected = Option

                    SelectedText.Text =
                        tostring(Selected)

                    Opened = false

                    Tween(
                        Container,
                        .25,
                        {
                            Size =
                                UDim2.new(
                                    1, 0, 0, 42
                                )
                        }
                    )

                    if Callback then
                        task.spawn(
                            Callback,
                            Selected
                        )
                    end

                end)

            end


            HeaderButton.MouseButton1Click:Connect(function()

                Opened = not Opened

                Tween(
                    Container,
                    .28,
                    {
                        Size = Opened
                            and UDim2.new(1, 0, 0, 180)
                            or UDim2.new(1, 0, 0, 42)
                    }
                )

            end)


            return {

                Set = function(_, Value)

                    if table.find(
                        Options,
                        Value
                    ) then

                        Selected = Value

                        SelectedText.Text =
                            tostring(Value)

                    end

                end,

                Get = function()
                    return Selected
                end

            }

        end

