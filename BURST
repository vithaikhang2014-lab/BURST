--========================================================--
-- WINDOW ANIMATION
--========================================================--

local Opened = true
local Animating = false

local function OpenUI()
    if Opened or Animating then
        return
    end

    Animating = true
    Opened = true

    Main.Visible = true

    Scale.Scale = .82

    Tween(
        Scale,
        .45,
        {
            Scale = 1
        },
        Enum.EasingStyle.Back
    )

    task.delay(.45, function()
        Animating = false
    end)
end

local function CloseUI()
    if not Opened or Animating then
        return
    end

    Animating = true
    Opened = false

    Tween(
        Scale,
        .32,
        {
            Scale = .82
        },
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.In
    )

    task.delay(.32, function()
        Main.Visible = false
        Scale.Scale = 1
        Animating = false
    end)
end

local function ToggleUI()
    if Opened then
        CloseUI()
    else
        OpenUI()
    end
end

