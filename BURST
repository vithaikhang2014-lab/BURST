function Burst:SetToggleKey(key)
    if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
        Config.ToggleKey = key

        Notify(
            "Burst",
            "Toggle key changed to " .. key.Name,
            2
        )
    end
end

function Burst:SetAccent(color)
    Config.Theme.Accent = color

    Glow.BackgroundColor3 = color
end

function Burst:Destroy()
    if ScreenGui then
        ScreenGui:Destroy()
    end
end

