            Update()

            Toggle.MouseButton1Click:Connect(function()
                State = not State
                Update()

                if callback then
                    task.spawn(callback, State)
                end
            end)

            return {
                Set = function(_, value)
                    State = value
                    Update()

                    if callback then
                        task.spawn(callback, State)
                    end
                end,

                Get = function()
                    return State
                end
