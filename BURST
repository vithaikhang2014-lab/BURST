        Parent = TabButton,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(0, 25, 1, 0),
        BackgroundTransparency = 1,
        Text = icon or "•",
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextColor3 = Config.Theme.SubText
    })

    local Label = New("TextLabel", {
        Parent = TabButton,
        Position = UDim2.new(0, 42, 0, 0),
        Size = UDim2.new(1, -45, 1, 0),
        BackgroundTransparency = 1,
        Text = name,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = Config.Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local Page = New("ScrollingFrame", {
        Parent = Content,
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Config.Theme.Accent,
        Visible = false,
        CanvasSize = UDim2.new()
    })

    local PagePadding = New("UIPadding", {
        Parent = Page,
        PaddingTop = UDim.new(0, 18),
        PaddingLeft = UDim.new(0, 18),
        PaddingRight = UDim.new(0, 18),
        PaddingBottom = UDim.new(0, 18)
    })

    local Layout = New("UIListLayout", {
        Parent = Page,
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder
    })

    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(
            0,
            0,
            0,
            Layout.AbsoluteContentSize.Y + 40
        )
    end)

    Pages[name] = Page

    local function Select()
        for _, page in pairs(Pages) do
            page.Visible = false
        end

        for _, child in ipairs(TabList:GetChildren()) do
            if child:IsA("TextButton") then
                Tween(child, TweenInfo.new(.15), {
                    BackgroundColor3 = Color3.fromRGB(20,22,30)
                }):Play()
            end
        end

        Page.Visible = true

        Tween(TabButton, TweenInfo.new(.15), {
            BackgroundColor3 = Color3.fromRGB(35, 31, 60)
        }):Play()

        Tween(Icon, TweenInfo.new(.15), {
            TextColor3 = Config.Theme.Accent
        }):Play()

        Tween(Label, TweenInfo.new(.15), {
            TextColor3 = Config.Theme.Text
        }):Play()

        CurrentPage = Page
    end

    TabButton.MouseButton1Click:Connect(Select)

    TabButton.MouseEnter:Connect(function()
        if CurrentPage ~= Page then
            Tween(TabButton, TweenInfo.new(.12), {
                BackgroundColor3 = Color3.fromRGB(27,29,39)
            }):Play()
        end
    end)

    TabButton.MouseLeave:Connect(function()
        if CurrentPage ~= Page then
            Tween(TabButton, TweenInfo.new(.12), {
                BackgroundColor3 = Color3.fromRGB(20,22,30)
            }):Play()
        end
