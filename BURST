        function GroupAPI:CreateSlider(
            Text,
            Min,
            Max,
            Default,
            Callback
        )

            Min =
                Min or 0

            Max =
                Max or 100

            local Value =
                math.clamp(
                    Default or Min,
                    Min,
                    Max
                )


            local Frame =
                New("Frame",{

                    Parent = Holder,

                    Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            60
                        ),

                    BackgroundColor3 =
                        Config.Theme.Tertiary,

                    BorderSizePixel = 0
                })

            Corner(Frame,10)


            New("TextLabel",{

                Parent = Frame,

                Position =
                    UDim2.new(
                        0,
                        13,
                        0,
                        8
                    ),

                Size =
                    UDim2.new(
                        .7,
                        0,
                        0,
                        18
                    ),

                BackgroundTransparency = 1,

                Text = Text,

                Font =
                    Enum.Font.GothamMedium,

                TextSize = 11,

                TextColor3 =
                    Config.Theme.Text,

                TextXAlignment =
                    Enum.TextXAlignment.Left
            })


            local ValueLabel =
                New("TextLabel",{

                    Parent = Frame,

                    AnchorPoint =
                        Vector2.new(
                            1,
                            0
                        ),

                    Position =
                        UDim2.new(
                            1,
                            -13,
                            0,
                            8
                        ),

                    Size =
                        UDim2.new(
                            0,
                            70,
                            0,
                            18
                        ),

                    BackgroundTransparency = 1,

                    Text =
                        tostring(Value),

                    Font =
                        Enum.Font.GothamBold,

                    TextSize = 11,

                    TextColor3 =
                        Config.Theme.Accent,

                    TextXAlignment =
                        Enum.TextXAlignment.Right
                })


            local Bar =
                New("Frame",{

                    Parent = Frame,

                    Position =
                        UDim2.new(
                            0,
                            13,
                            0,
                            36
                        ),

                    Size =
                        UDim2.new(
                            1,
                            -26,
                            0,
                            6
                        ),

                    BackgroundColor3 =
                        Color3.fromRGB(
                            42,44,55
                        )
                })

            Corner(Bar,10)


            local Percent =
                (Value-Min) /
                (Max-Min)


            local Fill =
                New("Frame",{

                    Parent = Bar,

                    Size =
                        UDim2.new(
                            Percent,
                            0,
                            1,
                            0
                        ),

                    BackgroundColor3 =
                        Config.Theme.Accent
                })

            Corner(Fill,10)


            local Sliding = false


            local function SetValue(
                NewValue
            )

                Value =
                    math.clamp(
                        NewValue,
                        Min,
                        Max
                    )


                local P =
                    (Value-Min) /
                    (Max-Min)


                Fill.Size =
                    UDim2.new(
                        P,
                        0,
                        1,
                        0
                    )


                ValueLabel.Text =
                    tostring(
                        math.floor(
                            Value*100
                        ) / 100
                    )


                if Callback then

                    task.spawn(
                        Callback,
                        Value
                    )

                end

            end


            Bar.InputBegan:Connect(
                function(Input)

                    if Input.UserInputType ==
                        Enum.UserInputType.MouseButton1
                    then

                        Sliding = true

                        local P =
                            math.clamp(
                                (
                                    Input.Position.X -
                                    Bar.AbsolutePosition.X
                                )
                                /
                                Bar.AbsoluteSize.X,
                                0,
                                1
                            )

                        SetValue(
                            Min +
                            (Max-Min)*P
                        )

                    end

                end
            )


            UserInputService.InputEnded:Connect(
                function(Input)

                    if Input.UserInputType ==
                        Enum.UserInputType.MouseButton1
                    then

                        Sliding = false

                    end

                end
            )


            UserInputService.InputChanged:Connect(
                function(Input)

                    if
                        Sliding
                        and
                        Input.UserInputType ==
                            Enum.UserInputType.MouseMovement
                    then

                        local P =
                            math.clamp(
                                (
                                    Input.Position.X -
                                    Bar.AbsolutePosition.X
                                )
                                /
                                Bar.AbsoluteSize.X,
                                0,
                                1
                            )

                        SetValue(
                            Min +
                            (Max-Min)*P
                        )

                    end

                end
            )


            return {

                Set = function(_,Value)

                    SetValue(Value)

                end,

                Get = function()

                    return Value

                end

            }

        end

