                    UDim2.new(1, -10, .5, 0),

                Size =
                    UDim2.new(.5, 0, 0, 30),

                BackgroundColor3 =
                    Config.Theme.Background,

                BorderSizePixel = 0,

                Text = Default or "",

                PlaceholderText =
                    Placeholder or "",

                PlaceholderColor3 =
                    Config.Theme.SubText,

                Font = Enum.Font.Gotham,
                TextSize = 10,

                TextColor3 =
                    Config.Theme.Text,

                ClearTextOnFocus = false
            })

            Corner(Box, 8)

            Box.FocusLost:Connect(function()

                if Callback then
                    task.spawn(
                        Callback,
                        Box.Text
                    )
                end

            end)

            return {
                Set = function(_, Value)
                    Box.Text = tostring(Value)
                end,

                Get = function()
                    return Box.Text
                end
            }

        end

        --================================================--
        -- DROPDOWN / CHOOSING
        --================================================--

        function API:CreateDropdown(
            Text,
            Options,
            Default,
            Callback
        )

            Options = Options or {}

            local Selected =
                Default or Options[1]

            local Opened = false

            local Frame = New("Frame", {
                Parent = Holder,

                Size =
                    UDim2.new(1, 0, 0, 44),

                BackgroundColor3 =
                    Config.Theme.Element,

                BorderSizePixel = 0,

                ClipsDescendants = true
            })

            Corner(Frame, 9)

            local Button = New("TextButton", {
                Parent = Frame,

                Size =
                    UDim2.new(1, 0, 0, 44),

                BackgroundTransparency = 1,

                Text = "",

                AutoButtonColor = false
            })

            New("TextLabel", {
                Parent = Button,

                Position =
                    UDim2.fromOffset(13, 0),

                Size =
                    UDim2.new(.5, 0, 1, 0),

                BackgroundTransparency = 1,

                Text = Text,

                Font =
                    Enum.Font.GothamMedium,

                TextSize = 11,

                TextColor3 =
                    Config.Theme.Text,

                TextXAlignment =
                    Enum.TextXAlignment.Left
            })

            local Current = New("TextLabel", {
                Parent = Button,

                AnchorPoint =
                    Vector2.new(1, .5),

                Position =
                    UDim2.new(1, -13, .5, 0),

                Size =
                    UDim2.fromOffset(150, 20),

                BackgroundTransparency = 1,

                Text =
                    tostring(Selected),

                Font =
                    Enum.Font.GothamMedium,

                TextSize = 10,

                TextColor3 =
                    Config.Theme.Accent,

                TextXAlignment =
                    Enum.TextXAlignment.Right
            })

            local List = New("ScrollingFrame", {
                Parent = Frame,

                Position =
                    UDim2.fromOffset(8, 48),

                Size =
                    UDim2.new(1, -16, 0, 120),

                BackgroundColor3 =
                    Config.Theme.Background,

                BorderSizePixel = 0,

                ScrollBarThickness = 2,

                AutomaticCanvasSize =
                    Enum.AutomaticSize.Y
            })

            Corner(List, 8)

            New("UIListLayout", {
                Parent = List,

                Padding = UDim.new(0, 4)
            })

            for _, Option in ipairs(Options) do

                local OptionButton =
                    New("TextButton", {

                        Parent = List,

                        Size =
                            UDim2.new(1, 0, 0, 30),

                        BackgroundColor3 =
                            Config.Theme.Element,

                        BorderSizePixel = 0,

                        Text =
                            tostring(Option),

                        Font =
                            Enum.Font.GothamMedium,

                        TextSize = 10,

                        TextColor3 =
                            Config.Theme.Text,

                        AutoButtonColor = false
                    })

                Corner(OptionButton, 7)

                OptionButton.MouseButton1Click:Connect(
                    function()

                        Selected = Option

                        Current.Text =
                            tostring(Selected)

                        Opened = false

                        Tween(
                            Frame,
                            .25,
                            {
                                Size =
                                    UDim2.new(
                                        1,
                                        0,
                                        0,
                                        44
                                    )
                            }
                        )

                        if Callback then
                            task.spawn(
                                Callback,
                                Selected
                            )
                        end

                    end
                )

            end

            Button.MouseButton1Click:Connect(function()

                Opened = not Opened

                Tween(
                    Frame,
                    .28,
                    {
                        Size =
                            Opened
                            and UDim2.new(
                                1, 0, 0, 180
                            )
                            or UDim2.new(
                                1, 0, 0, 44
                            )
                    }
                )

            end)

            return {
                Set = function(_, Value)

                    if table.find(
                        Options,
                        Value
                    ) then

                        Selected = Value
                        Current.Text =
                            tostring(Value)

                    end

                end,

                Get = function()
                    return Selected
                end
            }

        end

        --================================================--
        -- COLOR PICKER
        --================================================--

        function API:CreateColorPicker(
            Text,
            Default,
            Callback
        )

            local CurrentColor =
                Default
                or Color3.fromRGB(
                    135,
                    85,
                    255
                )

            local Opened = false

            local Frame = New("Frame", {
                Parent = Holder,

                Size =
                    UDim2.new(1, 0, 0, 44),

                BackgroundColor3 =
                    Config.Theme.Element,

                BorderSizePixel = 0,

                ClipsDescendants = true
            })

            Corner(Frame, 9)

            local Button = New("TextButton", {
                Parent = Frame,

                Size =
                    UDim2.new(1, 0, 0, 44),

                BackgroundTransparency = 1,

                Text = "",

                AutoButtonColor = false
            })

            New("TextLabel", {
                Parent = Button,

                Position =
                    UDim2.fromOffset(13, 0),

                Size =
                    UDim2.new(
                        1,
                        -80,
                        1,
                        0
                    ),

                BackgroundTransparency = 1,

                Text = Text,

                Font =
                    Enum.Font.GothamMedium,

                TextSize = 11,

                TextColor3 =
                    Config.Theme.Text,

                TextXAlignment =
                    Enum.TextXAlignment.Left
            })

            local Preview = New("Frame", {
                Parent = Button,

                AnchorPoint =
                    Vector2.new(1, .5),

                Position =
                    UDim2.new(
                        1,
                        -12,
                        .5,
                        0
                    ),

                Size =
                    UDim2.fromOffset(
                        38,
                        23
                    ),

                BackgroundColor3 =
                    CurrentColor,

                BorderSizePixel = 0
            })

            Corner(Preview, 7)

            local Palette = New("Frame", {
                Parent = Frame,

                Position =
                    UDim2.fromOffset(10, 52),

                Size =
                    UDim2.new(
                        1,
                        -20,
                        0,
                        160
                    ),

                BackgroundColor3 =
                    Color3.fromRGB(
                        15,
                        16,
                        23
                    ),

                BorderSizePixel = 0
            })

            Corner(Palette, 9)

            New("UIGridLayout", {
                Parent = Palette,

                CellSize =
                    UDim2.fromOffset(
                        30,
                        30
                    ),

                CellPadding =
                    UDim2.fromOffset(
                        5,
                        5
                    ),

                HorizontalAlignment =
                    Enum.HorizontalAlignment.Center,

                VerticalAlignment =
                    Enum.VerticalAlignment.Center
            })

            local Colors = {

                Color3.fromRGB(255, 0, 0),
                Color3.fromRGB(255, 70, 70),
                Color3.fromRGB(255, 140, 0),
                Color3.fromRGB(255, 200, 0),

                Color3.fromRGB(255, 255, 0),
                Color3.fromRGB(120, 255, 0),
                Color3.fromRGB(0, 255, 0),
                Color3.fromRGB(0, 255, 140),

                Color3.fromRGB(0, 255, 255),
                Color3.fromRGB(0, 150, 255),
                Color3.fromRGB(0, 60, 255),
                Color3.fromRGB(110, 0, 255),

                Color3.fromRGB(180, 0, 255),
                Color3.fromRGB(255, 0, 255),
                Color3.fromRGB(255, 0, 140),
                Color3.fromRGB(255, 255, 255),

                Color3.fromRGB(190, 190, 190),
                Color3.fromRGB(120, 120, 120),
                Color3.fromRGB(65, 65, 65),
                Color3.fromRGB(15, 15, 15)
            }

            for _, Color in ipairs(Colors) do

                local ColorButton =
                    New("TextButton", {

                        Parent = Palette,

                        BackgroundColor3 =
                            Color,

                        BorderSizePixel = 0,

                        Text = "",

                        AutoButtonColor = false
                    })

                Corner(ColorButton, 7)

                ColorButton.MouseButton1Click:Connect(
                    function()

                        CurrentColor =
                            Color

                        Preview.BackgroundColor3 =
                            Color

                        if Callback then
                            task.spawn(
                                Callback,
                                Color
                            )
                        end

                    end
                )

            end

            Button.MouseButton1Click:Connect(function()

                Opened = not Opened

                Tween(
                    Frame,
                    .28,
                    {
                        Size =
                            Opened
                            and UDim2.new(
                                1,
                                0,
                                0,
                                225
                            )
                            or UDim2.new(
                                1,
                                0,
                                0,
                                44
                            )
                    }
                )

            end)

            return {
                Set = function(_, Color)

                    if typeof(Color) ==
                        "Color3"
                    then

                        CurrentColor =
                            Color

                        Preview.BackgroundColor3 =
                            Color

                    end

                end,

                Get = function()
                    return CurrentColor
                end
            }

        end

        return API
    end

    return Tab
end

