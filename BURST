            Corner(Fill, 6)

            local Knob = New("Frame", {
                Parent = Bar,
                AnchorPoint = Vector2.new(.5,.5),
                Position = UDim2.new((Value-min)/(max-min), 0, .5, 0),
                Size = UDim2.new(0, 12, 0, 12),
                BackgroundColor3 = Color3.new(1,1,1)
            })

            Corner(Knob, 20)

            local Sliding = false

            local function SetValue(value)
                Value = math.clamp(value, min, max)

                local Percent = (Value-min)/(max-min)

                Fill.Size = UDim2.new(Percent,0,1,0)

                Tween(Knob, TweenInfo.new(.08), {
                    Position = UDim2.new(Percent,0,.5,0)
                }):Play()

                ValueLabel.Text = tostring(
                    math.floor(Value * 100) / 100
                )

                if callback then
                    task.spawn(callback, Value)
                end
            end

            Bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Sliding = true

                    local Percent = math.clamp(
                        (input.Position.X - Bar.AbsolutePosition.X)
                        / Bar.AbsoluteSize.X,
                        0,
                        1
                    )

                    SetValue(min + (max-min)*Percent)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Sliding = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if Sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local Percent = math.clamp(
                        (input.Position.X - Bar.AbsolutePosition.X)
                        / Bar.AbsoluteSize.X,
                        0,
                        1
                    )

                    SetValue(min + (max-min)*Percent)
                end
            end)

            return {
                Set = function(_, value)
                    SetValue(value)
                end,

                Get = function()
                    return Value
                end
            }
        end

        --================================================
        -- COLOR PICKER
        --================================================

        function GroupObject:CreateColorPicker(text, default, callback)
            local Color = default or Color3.new(1,1,1)

            local Button = New("TextButton", {
                Parent = ContainerFrame,
                Size = UDim2.new(1,0,0,42),
                BackgroundColor3 = Config.Theme.Tertiary,
                Text = "",
                BorderSizePixel = 0,
                AutoButtonColor = false
            })

            Corner(Button,8)

            local Label = New("TextLabel", {
                Parent = Button,
                Position = UDim2.new(0,13,0,0),
                Size = UDim2.new(1,-75,1,0),
                BackgroundTransparency = 1,
                Text = text,
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                TextColor3 = Config.Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left
            })

            local Preview = New("Frame", {
                Parent = Button,
                AnchorPoint = Vector2.new(1,.5),
                Position = UDim2.new(1,-12,.5,0),
                Size = UDim2.new(0,35,0,22),
                BackgroundColor3 = Color
            })

            Corner(Preview,7)
            Stroke(Preview,Color3.new(1,1,1),.75)

            Button.MouseButton1Click:Connect(function()
                -- Simple RGB cycle picker.
                -- You can replace this section with a full HSV picker.
                Color = Color3.fromHSV(
                    (tick() % 10) / 10,
                    .85,
                    1
                )

                Preview.BackgroundColor3 = Color

                if callback then
                    task.spawn(callback, Color)
                end
            end)

            return {
                Set = function(_, value)
                    Color = value
                    Preview.BackgroundColor3 = value

                    if callback then
                        task.spawn(callback, value)
                    end
                end,

                Get = function()
                    return Color
                end
            }
        end

        return GroupObject
    end

    -- automatically select first tab
    if not CurrentPage then
        task.defer(Select)
    end

    return TabObject
end

