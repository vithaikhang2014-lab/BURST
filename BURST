--[[
    Burst UI Library
    Rayfield-style UI Library
    Version: 1.0

    Usage:
        local Burst = loadstring(game:HttpGet("YOUR_RAW_URL"))()

        local Window = Burst:CreateWindow({
            Name = "Burst",
            ToggleKey = Enum.KeyCode.K
        })

        local Tab = Window:CreateTab("Main")

        local Group = Tab:CreateGroup("Main Functions")

        Group:CreateButton({
            Name = "Test Button",
            Callback = function()
                print("Hello Burst!")
            end
        })

        Group:CreateToggle({
            Name = "Test Toggle",
            Default = false,
            Callback = function(Value)
                print("Toggle:", Value)
            end
        })

        Group:CreateSlider({
            Name = "WalkSpeed",
            Min = 16,
            Max = 200,
            Default = 16,
            Increment = 1,
            Callback = function(Value)
                print("Speed:", Value)
            end
        })

        Group:CreateColorPicker({
            Name = "ESP Color",
            Default = Color3.fromRGB(255, 0, 0),
            Callback = function(Color)
                print(Color)
            end
        })

        Group:CreateSection("Other")

        Group:CreateButton({
            Name = "Another Button",
            Callback = function()
                print("Clicked!")
            end
        })
]]

local Burst = {}

--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

--// Theme
Burst.Theme = {
    Background = Color3.fromRGB(18, 18, 22),
    Secondary = Color3.fromRGB(24, 24, 30),
    Element = Color3.fromRGB(30, 30, 37),
    ElementHover = Color3.fromRGB(38, 38, 47),

    Text = Color3.fromRGB(240, 240, 245),
    SubText = Color3.fromRGB(160, 160, 170),

    Accent = Color3.fromRGB(125, 85, 255),
    AccentDark = Color3.fromRGB(100, 65, 220),

    Stroke = Color3.fromRGB(55, 55, 65),
    ToggleOff = Color3.fromRGB(60, 60, 68)
}

--// Utility
local function New(class, properties)
    local Object = Instance.new(class)

    for Property, Value in pairs(properties or {}) do
        Object[Property] = Value
    end

    return Object
end

local function Corner(Object, Radius)
    local C = Instance.new("UICorner")
    C.CornerRadius = UDim.new(0, Radius or 6)
    C.Parent = Object
    return C
end

local function Stroke(Object, Color, Thickness)
    local S = Instance.new("UIStroke")
    S.Color = Color or Burst.Theme.Stroke
    S.Thickness = Thickness or 1
    S.Transparency = 0.15
    S.Parent = Object
    return S
end

local function Tween(Object, Time, Properties)
    local Info = TweenInfo.new(
        Time or 0.15,
        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )

    TweenService:Create(Object, Info, Properties):Play()
end

local function MakeDraggable(Frame, Handle)
    local Dragging = false
    local DragStart
    local StartPosition

    Handle = Handle or Frame

    Handle.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

            Dragging = true
            DragStart = Input.Position
            StartPosition = Frame.Position

            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then
            return
        end

        if Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch then

            local Delta = Input.Position - DragStart

            Frame.Position = UDim2.new(
                StartPosition.X.Scale,
                StartPosition.X.Offset + Delta.X,
                StartPosition.Y.Scale,
                StartPosition.Y.Offset + Delta.Y
            )
        end
    end)
end

--========================================================
-- WINDOW
--========================================================

function Burst:CreateWindow(Config)

    Config = Config or {}

    local WindowName = Config.Name or "Burst"
    local ToggleKey = Config.ToggleKey or Enum.KeyCode.K

    local ScreenGui = New("ScreenGui", {
        Name = "BurstUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    })

    -- Protect from duplicates
    pcall(function()
        ScreenGui.Parent = game:GetService("CoreGui")
    end)

    if not ScreenGui.Parent then
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    --====================================================
    -- MAIN
    --====================================================

    local Main = New("Frame", {
        Name = "Main",
        Parent = ScreenGui,

        Size = UDim2.new(0, 650, 0, 420),
        Position = UDim2.new(0.5, -325, 0.5, -210),

        BackgroundColor3 = Burst.Theme.Background,
        BorderSizePixel = 0
    })

    Corner(Main, 10)
    Stroke(Main)

    --====================================================
    -- TOP BAR
    --====================================================

    local TopBar = New("Frame", {
        Parent = Main,

        Size = UDim2.new(1, 0, 0, 55),

        BackgroundColor3 = Burst.Theme.Secondary,
        BorderSizePixel = 0
    })

    Corner(TopBar, 10)

    local Title = New("TextLabel", {
        Parent = TopBar,

        Position = UDim2.new(0, 18, 0, 0),
        Size = UDim2.new(0, 250, 1, 0),

        BackgroundTransparency = 1,

        Text = WindowName,
        TextColor3 = Burst.Theme.Text,
        TextSize = 20,
        Font = Enum.Font.GothamBold,

        TextXAlignment = Enum.TextXAlignment.Left
    })

    local Close = New("TextButton", {
        Parent = TopBar,

        Position = UDim2.new(1, -45, 0, 10),
        Size = UDim2.new(0, 35, 0, 35),

        BackgroundColor3 = Burst.Theme.Element,

        Text = "×",
        TextColor3 = Burst.Theme.Text,
        TextSize = 24,
        Font = Enum.Font.GothamBold,

        AutoButtonColor = false
    })

    Corner(Close, 7)

    Close.MouseEnter:Connect(function()
        Tween(Close, 0.12, {
            BackgroundColor3 = Color3.fromRGB(180, 55, 65)
        })
    end)

    Close.MouseLeave:Connect(function()
        Tween(Close, 0.12, {
            BackgroundColor3 = Burst.Theme.Element
        })
    end)

    --====================================================
    -- SIDEBAR
    --====================================================

    local Sidebar = New("Frame", {
        Parent = Main,

        Position = UDim2.new(0, 0, 0, 55),
        Size = UDim2.new(0, 145, 1, -55),

        BackgroundColor3 = Burst.Theme.Secondary,
        BorderSizePixel = 0
    })

    local TabList = New("ScrollingFrame", {
        Parent = Sidebar,

        Position = UDim2.new(0, 8, 0, 10),
        Size = UDim2.new(1, -16, 1, -20),

        BackgroundTransparency = 1,

        BorderSizePixel = 0,

        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Burst.Theme.Accent,

        AutomaticCanvasSize = Enum.AutomaticSize.Y
    })

    local TabLayout = New("UIListLayout", {
        Parent = TabList,

        Padding = UDim.new(0, 6),

        SortOrder = Enum.SortOrder.LayoutOrder
    })

    --====================================================
    -- CONTENT
    --====================================================

    local Content = New("Frame", {
        Parent = Main,

        Position = UDim2.new(0, 145, 0, 55),
        Size = UDim2.new(1, -145, 1, -55),

        BackgroundColor3 = Burst.Theme.Background,
        BorderSizePixel = 0
    })

    local Pages = {}

    local Window = {}

    --====================================================
    -- TAB
    --====================================================

    function Window:CreateTab(TabName)

        local TabButton = New("TextButton", {
            Parent = TabList,

            Size = UDim2.new(1, 0, 0, 38),

            BackgroundColor3 = Burst.Theme.Secondary,

            Text = TabName,
            TextColor3 = Burst.Theme.SubText,
            TextSize = 13,
            Font = Enum.Font.GothamMedium,

            AutoButtonColor = false
        })

        Corner(TabButton, 6)

        local Page = New("ScrollingFrame", {
            Parent = Content,

            Size = UDim2.new(1, 0, 1, 0),

            BackgroundTransparency = 1,

            BorderSizePixel = 0,

            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Burst.Theme.Accent,

            CanvasSize = UDim2.new(0, 0, 0, 0),

            AutomaticCanvasSize = Enum.AutomaticSize.Y,

            Visible = false
        })

        local Padding = New("UIPadding", {
            Parent = Page,

            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12)
        })

        local PageLayout = New("UIListLayout", {
            Parent = Page,

            Padding = UDim.new(0, 10),

            SortOrder = Enum.SortOrder.LayoutOrder
        })

        Pages[#Pages + 1] = {
            Button = TabButton,
            Page = Page
        }

        local function Select()
            for _, Data in ipairs(Pages) do
                Data.Page.Visible = false

                Tween(Data.Button, 0.12, {
                    BackgroundColor3 = Burst.Theme.Secondary,
                    TextColor3 = Burst.Theme.SubText
                })
            end

            Page.Visible = true

            Tween(TabButton, 0.12, {
                BackgroundColor3 = Burst.Theme.Accent,
                TextColor3 = Color3.new(1, 1, 1)
            })
        end

        TabButton.MouseButton1Click:Connect(Select)

        if #Pages == 1 then
            Select()
        end

        local Tab = {}

        --================================================
        -- GROUP
        --================================================

        function Tab:CreateGroup(GroupName)

            local GroupFrame = New("Frame", {
                Parent = Page,

                Size = UDim2.new(1, 0, 0, 0),

                BackgroundColor3 = Burst.Theme.Secondary,

                BorderSizePixel = 0,

                AutomaticSize = Enum.AutomaticSize.Y
            })

            Corner(GroupFrame, 8)
            Stroke(GroupFrame)

            local GroupTitle = New("TextLabel", {
                Parent = GroupFrame,

                Position = UDim2.new(0, 14, 0, 0),
                Size = UDim2.new(1, -28, 0, 38),

                BackgroundTransparency = 1,

                Text = GroupName,
                TextColor3 = Burst.Theme.Text,

                TextSize = 15,
                Font = Enum.Font.GothamBold,

                TextXAlignment = Enum.TextXAlignment.Left
            })

            local Elements = New("Frame", {
                Parent = GroupFrame,

                Position = UDim2.new(0, 10, 0, 38),
                Size = UDim2.new(1, -20, 0, 0),

                BackgroundTransparency = 1,

                AutomaticSize = Enum.AutomaticSize.Y
            })

            local ElementLayout = New("UIListLayout", {
                Parent = Elements,

                Padding = UDim.new(0, 7),

                SortOrder = Enum.SortOrder.LayoutOrder
            })

            local Group = {}

            --============================================
            -- BUTTON
            --============================================

            function Group:CreateButton(Config)

                Config = Config or {}

                local Button = New("TextButton", {
                    Parent = Elements,

                    Size = UDim2.new(1, 0, 0, 40),

                    BackgroundColor3 = Burst.Theme.Element,

                    Text = Config.Name or "Button",

                    TextColor3 = Burst.Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamMedium,

                    AutoButtonColor = false
                })

                Corner(Button, 6)

                Button.MouseEnter:Connect(function()
                    Tween(Button, 0.12, {
                        BackgroundColor3 = Burst.Theme.ElementHover
                    })
                end)

                Button.MouseLeave:Connect(function()
                    Tween(Button, 0.12, {
                        BackgroundColor3 = Burst.Theme.Element
                    })
                end)

                Button.MouseButton1Click:Connect(function()

                    Tween(Button, 0.08, {
                        BackgroundColor3 = Burst.Theme.Accent
                    })

                    task.delay(0.1, function()
                        Tween(Button, 0.12, {
                            BackgroundColor3 = Burst.Theme.Element
                        })
                    end)

                    if Config.Callback then
                        task.spawn(Config.Callback)
                    end
                end)

                return Button
            end

            --============================================
            -- TOGGLE
            --============================================

            function Group:CreateToggle(Config)

                Config = Config or {}

                local Value = Config.Default or false

                local Holder = New("Frame", {
                    Parent = Elements,

                    Size = UDim2.new(1, 0, 0, 45),

                    BackgroundColor3 = Burst.Theme.Element,

                    BorderSizePixel = 0
                })

                Corner(Holder, 6)

                local Label = New("TextLabel", {
                    Parent = Holder,

                    Position = UDim2.new(0, 12, 0, 0),
                    Size = UDim2.new(1, -70, 1, 0),

                    BackgroundTransparency = 1,

                    Text = Config.Name or "Toggle",

                    TextColor3 = Burst.Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamMedium,

                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local Switch = New("TextButton", {
                    Parent = Holder,

                    Position = UDim2.new(1, -55, 0.5, -10),
                    Size = UDim2.new(0, 43, 0, 20),

                    BackgroundColor3 = Burst.Theme.ToggleOff,

                    Text = "",

                    AutoButtonColor = false
                })

                Corner(Switch, 20)

                local Knob = New("Frame", {
                    Parent = Switch,

                    Position = UDim2.new(0, 3, 0.5, -7),
                    Size = UDim2.new(0, 14, 0, 14),

                    BackgroundColor3 = Color3.fromRGB(220, 220, 225)
                })

                Corner(Knob, 20)

                local function Update()

                    if Value then

                        Tween(Switch, 0.15, {
                            BackgroundColor3 = Burst.Theme.Accent
                        })

                        Tween(Knob, 0.15, {
                            Position = UDim2.new(1, -17, 0.5, -7)
                        })

                    else

                        Tween(Switch, 0.15, {
                            BackgroundColor3 = Burst.Theme.ToggleOff
                        })

                        Tween(Knob, 0.15, {
                            Position = UDim2.new(0, 3, 0.5, -7)
                        })

                    end

                    if Config.Callback then
                        task.spawn(Config.Callback, Value)
                    end
                end

                Switch.MouseButton1Click:Connect(function()
                    Value = not Value
                    Update()
                end)

                Update()

                return {
                    Set = function(_, NewValue)
                        Value = NewValue
                        Update()
                    end,

                    Get = function()
                        return Value
                    end
                }
            end

            --============================================
            -- SLIDER
            --============================================

            function Group:CreateSlider(Config)

                Config = Config or {}

                local Min = Config.Min or 0
                local Max = Config.Max or 100
                local Increment = Config.Increment or 1
                local Value = Config.Default or Min

                local Holder = New("Frame", {
                    Parent = Elements,

                    Size = UDim2.new(1, 0, 0, 62),

                    BackgroundColor3 = Burst.Theme.Element,

                    BorderSizePixel = 0
                })

                Corner(Holder, 6)

                local Label = New("TextLabel", {
                    Parent = Holder,

                    Position = UDim2.new(0, 12, 0, 7),
                    Size = UDim2.new(1, -80, 0, 20),

                    BackgroundTransparency = 1,

                    Text = Config.Name or "Slider",

                    TextColor3 = Burst.Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamMedium,

                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local ValueLabel = New("TextLabel", {
                    Parent = Holder,

                    Position = UDim2.new(1, -65, 0, 7),
                    Size = UDim2.new(0, 53, 0, 20),

                    BackgroundTransparency = 1,

                    Text = tostring(Value),

                    TextColor3 = Burst.Theme.SubText,
                    TextSize = 12,
                    Font = Enum.Font.GothamMedium,

                    TextXAlignment = Enum.TextXAlignment.Right
                })

                local Bar = New("Frame", {
                    Parent = Holder,

                    Position = UDim2.new(0, 12, 0, 38),
                    Size = UDim2.new(1, -24, 0, 6),

                    BackgroundColor3 = Burst.Theme.ToggleOff
                })

                Corner(Bar, 6)

                local Fill = New("Frame", {
                    Parent = Bar,

                    Size = UDim2.new(
                        (Value - Min) / (Max - Min),
                        0,
                        1,
                        0
                    ),

                    BackgroundColor3 = Burst.Theme.Accent
                })

                Corner(Fill, 6)

                local Drag = New("TextButton", {
                    Parent = Bar,

                    Size = UDim2.new(1, 0, 0, 25),
                    Position = UDim2.new(0, 0, 0.5, -12),

                    BackgroundTransparency = 1,

                    Text = "",

                    AutoButtonColor = false
                })

                local Dragging = false

                local function SetValue(NewValue)

                    NewValue = math.clamp(NewValue, Min, Max)

                    NewValue = math.floor(
                        NewValue / Increment + 0.5
                    ) * Increment

                    Value = NewValue

                    local Percent = (Value - Min) / (Max - Min)

                    Fill.Size = UDim2.new(
                        Percent,
                        0,
                        1,
                        0
                    )

                    ValueLabel.Text = tostring(Value)

                    if Config.Callback then
                        task.spawn(Config.Callback, Value)
                    end
                end

                Drag.MouseButton1Down:Connect(function()
                    Dragging = true
                end)

                UserInputService.InputEnded:Connect(function(Input)

                    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Dragging = false
                    end

                end)

                UserInputService.InputChanged:Connect(function(Input)

                    if not Dragging then
                        return
                    end

                    if Input.UserInputType == Enum.UserInputType.MouseMovement then

                        local Percent = math.clamp(
                            (Input.Position.X - Bar.AbsolutePosition.X)
                            / Bar.AbsoluteSize.X,
                            0,
                            1
                        )

                        SetValue(
                            Min + ((Max - Min) * Percent)
                        )
                    end

                end)

                return {
                    Set = function(_, NewValue)
                        SetValue(NewValue)
                    end,

                    Get = function()
                        return Value
                    end
                }
            end

            --============================================
            -- COLOR PICKER
            --============================================

            function Group:CreateColorPicker(Config)

                Config = Config or {}

                local Value =
                    Config.Default
                    or Color3.fromRGB(255, 0, 0)

                local Holder = New("Frame", {
                    Parent = Elements,

                    Size = UDim2.new(1, 0, 0, 45),

                    BackgroundColor3 = Burst.Theme.Element,

                    BorderSizePixel = 0
                })

                Corner(Holder, 6)

                local Label = New("TextLabel", {
                    Parent = Holder,

                    Position = UDim2.new(0, 12, 0, 0),
                    Size = UDim2.new(1, -70, 1, 0),

                    BackgroundTransparency = 1,

                    Text = Config.Name or "Color",

                    TextColor3 = Burst.Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamMedium,

                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local ColorButton = New("TextButton", {
                    Parent = Holder,

                    Position = UDim2.new(1, -50, 0.5, -12),
                    Size = UDim2.new(0, 38, 0, 24),

                    BackgroundColor3 = Value,

                    Text = "",

                    AutoButtonColor = false
                })

                Corner(ColorButton, 6)
                Stroke(ColorButton)

                local Popup

                local function CreatePopup()

                    if Popup then
                        Popup:Destroy()
                        Popup = nil
                        return
                    end

                    Popup = New("Frame", {
                        Parent = ScreenGui,

                        Position = UDim2.new(
                            0,
                            ColorButton.AbsolutePosition.X,
                            0,
                            ColorButton.AbsolutePosition.Y + 30
                        ),

                        Size = UDim2.new(0, 220, 0, 150),

                        BackgroundColor3 = Burst.Theme.Secondary,

                        BorderSizePixel = 0,

                        ZIndex = 20
                    })

                    Corner(Popup, 8)
                    Stroke(Popup)

                    local Hue = New("TextBox", {
                        Parent = Popup,

                        Position = UDim2.new(0, 10, 0, 15),
                        Size = UDim2.new(1, -20, 0, 32),

                        BackgroundColor3 = Burst.Theme.Element,

                        Text = "",

                        PlaceholderText = "Hex Color (#RRGGBB)",

                        PlaceholderColor3 = Burst.Theme.SubText,

                        TextColor3 = Burst.Theme.Text,
                        TextSize = 13,
                        Font = Enum.Font.Gotham,

                        ClearTextOnFocus = false
                    })

                    Corner(Hue, 6)

                    Hue.FocusLost:Connect(function()

                        local Text = Hue.Text:gsub("#", "")

                        if #Text == 6 then

                            local R = tonumber(Text:sub(1, 2), 16)
                            local G = tonumber(Text:sub(3, 4), 16)
                            local B = tonumber(Text:sub(5, 6), 16)

                            if R and G and B then

                                Value = Color3.fromRGB(R, G, B)

                                ColorButton.BackgroundColor3 = Value

                                if Config.Callback then
                                    task.spawn(
                                        Config.Callback,
                                        Value
                                    )
                                end
                            end
                        end
                    end)

                    local ClosePopup = New("TextButton", {
                        Parent = Popup,

                        Position = UDim2.new(0, 10, 1, -48),
                        Size = UDim2.new(1, -20, 0, 35),

                        BackgroundColor3 = Burst.Theme.Accent,

                        Text = "Done",

                        TextColor3 = Color3.new(1, 1, 1),
                        TextSize = 13,
                        Font = Enum.Font.GothamBold,

                        AutoButtonColor = false
                    })

                    Corner(ClosePopup, 6)

                    ClosePopup.MouseButton1Click:Connect(function()
                        Popup:Destroy()
                        Popup = nil
                    end)
                end

                ColorButton.MouseButton1Click:Connect(CreatePopup)

                return {
                    Set = function(_, NewColor)

                        if typeof(NewColor) == "Color3" then

                            Value = NewColor

                            ColorButton.BackgroundColor3 = Value

                            if Config.Callback then
                                task.spawn(
                                    Config.Callback,
                                    Value
                                )
                            end
                        end
                    end,

                    Get = function()
                        return Value
                    end
                }
            end

            --============================================
            -- SECTION / GROUP IN GROUP
            --============================================

            function Group:CreateSection(Name)

                local Section = New("Frame", {
                    Parent = Elements,

                    Size = UDim2.new(1, 0, 0, 28),

                    BackgroundTransparency = 1
                })

                local LineLeft = New("Frame", {
                    Parent = Section,

                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.new(0.08, 0, 0, 1),

                    BackgroundColor3 = Burst.Theme.Stroke,
                    BorderSizePixel = 0
                })

                local Text = New("TextLabel", {
                    Parent = Section,

                    Position = UDim2.new(0.1, 0, 0, 0),
                    Size = UDim2.new(0.8, 0, 1, 0),

                    BackgroundTransparency = 1,

                    Text = Name or "Section",

                    TextColor3 = Burst.Theme.SubText,
                    TextSize = 11,
                    Font = Enum.Font.GothamBold,

                    TextXAlignment = Enum.TextXAlignment.Center
                })

                local LineRight = New("Frame", {
                    Parent = Section,

                    Position = UDim2.new(0.92, 0, 0.5, 0),
                    Size = UDim2.new(0.08, 0, 0, 1),

                    BackgroundColor3 = Burst.Theme.Stroke,
                    BorderSizePixel = 0
                })

                return Section
            end

            return Group
        end

        return Tab
    end

    --====================================================
    -- CLOSE / TOGGLE
    --====================================================

    local Open = true

    local function SetVisible(State)

        Open = State
        Main.Visible = State

    end

    Close.MouseButton1Click:Connect(function()
        SetVisible(false)
    end)

    UserInputService.InputBegan:Connect(function(Input, Processed)

        if Processed then
            return
        end

        if Input.KeyCode == ToggleKey then
            SetVisible(not Open)
        end

    end)

    --====================================================
    -- DRAG
    --====================================================

    MakeDraggable(Main, TopBar)

    --====================================================
    -- API
    --====================================================

    function Window:SetToggleKey(Key)
        ToggleKey = Key
    end

    function Window:SetVisible(State)
        SetVisible(State)
    end

    function Window:Destroy()
        ScreenGui:Destroy()
    end

    return Window
end

return Burst
