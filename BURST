                Text = Text,

                Font = Enum.Font.GothamMedium,
                TextSize = 11,

                TextColor3 = Config.Theme.Text,

                TextXAlignment = Enum.TextXAlignment.Left
            })

            local Switch = New("Frame", {
                Parent = Button,

                AnchorPoint = Vector2.new(1, .5),

                Position = UDim2.new(1, -12, .5, 0),

                Size = UDim2.fromOffset(42, 22),

                BackgroundColor3 =
                    Color3.fromRGB(43, 45, 56)
            })

            Corner(Switch, 20)

            local Knob = New("Frame", {
                Parent = Switch,

                AnchorPoint = Vector2.new(0, .5),

                Position = UDim2.new(0, 3, .5, 0),

                Size = UDim2.fromOffset(16, 16),

                BackgroundColor3 =
                    Color3.fromRGB(230, 230, 235)
            })

            Corner(Knob, 20)

            local function Update()

                Tween(
                    Switch,
                    .2,
                    {
                        BackgroundColor3 =
                            State
                            and Config.Theme.Accent
                            or Color3.fromRGB(43, 45, 56)
                    }
                )

                Tween(
                    Knob,
                    .22,
                    {
                        Position =
                            State
                            and UDim2.new(1, -19, .5, 0)
                            or UDim2.new(0, 3, .5, 0)
                    }
                )

            end

            Update()

            Button.MouseButton1Click:Connect(function()

                State = not State

                Update()

                if Callback then
                    task.spawn(
                        Callback,
                        State
                    )
                end

            end)

            return {
                Set = function(_, Value)
                    State = Value == true
                    Update()
                end,

                Get = function()
                    return State
                end
            }

        end

        --================================================--
        -- SLIDER
        --================================================--

        function API:CreateSlider(
            Text,
            Min,
            Max,
            Default,
            Callback
        )

            Min = Min or 0
            Max = Max or 100
            Default = Default or Min

            local Value =
                math.clamp(Default, Min, Max)

            local Frame = New("Frame", {
                Parent = Holder,

                Size = UDim2.new(1, 0, 0, 60),

                BackgroundColor3 = Config.Theme.Element,

                BorderSizePixel = 0
            })

            Corner(Frame, 9)

            New("TextLabel", {
                Parent = Frame,

                Position = UDim2.fromOffset(13, 7),

                Size = UDim2.new(.7, 0, 0, 18),

                BackgroundTransparency = 1,

                Text = Text,

                Font = Enum.Font.GothamMedium,
                TextSize = 11,

                TextColor3 = Config.Theme.Text,

                TextXAlignment = Enum.TextXAlignment.Left
            })

            local ValueText = New("TextLabel", {
                Parent = Frame,

                AnchorPoint = Vector2.new(1, 0),

                Position = UDim2.new(1, -13, 0, 7),

                Size = UDim2.fromOffset(70, 18),

                BackgroundTransparency = 1,

                Text = tostring(Value),

                Font = Enum.Font.GothamBold,
                TextSize = 10,

                TextColor3 = Config.Theme.Accent,

                TextXAlignment = Enum.TextXAlignment.Right
            })

            local Bar = New("Frame", {
                Parent = Frame,

                Position = UDim2.fromOffset(13, 37),

                Size = UDim2.new(1, -26, 0, 6),

                BackgroundColor3 =
                    Color3.fromRGB(42, 44, 55),

                BorderSizePixel = 0
            })

            Corner(Bar, 10)

            local Fill = New("Frame", {
                Parent = Bar,

                Size = UDim2.new(
                    (Value - Min) / (Max - Min),
                    0,
                    1,
                    0
                ),

                BackgroundColor3 =
                    Config.Theme.Accent,

                BorderSizePixel = 0
            })

            Corner(Fill, 10)

            local Sliding = false

            local function Set(ValueInput)

                Value =
                    math.clamp(
                        ValueInput,
                        Min,
                        Max
                    )

                local Percent =
                    (Value - Min) /
                    (Max - Min)

                Tween(
                    Fill,
                    .08,
                    {
                        Size = UDim2.new(
                            Percent,
                            0,
                            1,
                            0
                        )
                    },
                    Enum.EasingStyle.Linear
                )

                ValueText.Text =
                    tostring(
                        math.floor(
                            Value * 100
                        ) / 100
                    )

                if Callback then
                    task.spawn(
                        Callback,
                        Value
                    )
                end

            end

            Bar.InputBegan:Connect(function(Input)

                if Input.UserInputType ==
                    Enum.UserInputType.MouseButton1
                then

                    Sliding = true

                end

            end)

            UserInputService.InputEnded:Connect(function(Input)

                if Input.UserInputType ==
                    Enum.UserInputType.MouseButton1
                then

                    Sliding = false

                end

            end)

            UserInputService.InputChanged:Connect(function(Input)

                if not Sliding then
                    return
                end

                if Input.UserInputType ~=
                    Enum.UserInputType.MouseMovement
                then
                    return
                end

                local Percent =
                    math.clamp(
                        (
                            Input.Position.X -
                            Bar.AbsolutePosition.X
                        )
                        /
                        Bar.AbsoluteSize.X,

                        0,
                        1
                    )

                Set(
                    Min +
                    (Max - Min) * Percent
                )

            end)

            return {
                Set = function(_, NewValue)
                    Set(NewValue)
                end,

                Get = function()
                    return Value
                end
            }

        end

