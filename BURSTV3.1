                Font =
                    Enum.Font.GothamMedium,

                TextSize =
                    12,

                TextColor3 =
                    Config.Theme.SubText,

                TextXAlignment =
                    Enum.TextXAlignment.Left,

                ZIndex =
                    7
            }
        )


    local Page =
        New(
            "ScrollingFrame",
            {
                Parent =
                    Content,

                Size =
                    UDim2.fromScale(
                        1,
                        1
                    ),

                Position =
                    UDim2.new(
                        0,
                        30,
                        0,
                        0
                    ),

                BackgroundTransparency =
                    1,

                BorderSizePixel =
                    0,

                ScrollBarThickness =
                    3,

                ScrollBarImageColor3 =
                    Config.Theme.Accent,

                ScrollBarImageTransparency =
                    .2,

                CanvasSize =
                    UDim2.new(),

                Visible =
                    false,

                ZIndex =
                    3
            }
        )


    New(
        "UIPadding",
        {
            Parent =
                Page,

            PaddingTop =
                UDim.new(
                    0,
                    20
                ),

            PaddingLeft =
                UDim.new(
                    0,
                    20
                ),

            PaddingRight =
                UDim.new(
                    0,
                    20
                ),

            PaddingBottom =
                UDim.new(
                    0,
                    20
                )
        }
    )


    local Layout =
        New(
            "UIListLayout",
            {
                Parent =
                    Page,

                Padding =
                    UDim.new(
                        0,
                        12
                    ),

                SortOrder =
                    Enum.SortOrder.LayoutOrder
            }
        )


    Layout:GetPropertyChangedSignal(
        "AbsoluteContentSize"
    ):Connect(
        function()

            Page.CanvasSize =
                UDim2.new(
                    0,
                    0,
                    0,
                    Layout.AbsoluteContentSize.Y
                        + 40
                )

        end
    )


    Pages[Name] =
        Page


    TabObjects[Name] = {

        Button =
            TabButton,

        Icon =
            IconLabel,

        Label =
            NameLabel,

        Indicator =
            Indicator,

        Page =
            Page
    }


    local function Select()

        if CurrentPage ==
            Page
        then
            return
        end


        for _, Data in pairs(
            TabObjects
        ) do

            Tween(
                Data.Button,
                .2,
                {
                    BackgroundColor3 =
                        Config.Theme.Secondary
                }
            )

            Tween(
                Data.Icon,
                .2,
                {
                    TextColor3 =
                        Config.Theme.SubText
                }
            )

            Tween(
                Data.Label,
                .2,
                {
                    TextColor3 =
                        Config.Theme.SubText
                }
            )

            Tween(
                Data.Indicator,
                .2,
                {
                    BackgroundTransparency =
                        1
                }
            )

        end


        for _, P in pairs(
            Pages
        ) do

            P.Visible =
                false

        end


        Page.Visible =
            true

        Page.Position =
            UDim2.new(
                0,
                20,
                0,
                0
            )


        Tween(
            Page,
            .32,
            {
                Position =
                    UDim2.new(
                        0,
                        0,
                        0,
                        0
                    )
            }
        )


        Tween(
            TabButton,
            .22,
            {
                BackgroundColor3 =
                    Color3.fromRGB(
                        39,
                        31,
                        63
                    )
            }
        )


        Tween(
            IconLabel,
            .22,
            {
                TextColor3 =
                    Config.Theme.Accent
            }
        )


        Tween(
            NameLabel,
            .22,
            {
                TextColor3 =
                    Config.Theme.Text
            }
        )


        Tween(
            Indicator,
            .22,
            {
                BackgroundTransparency =
                    0
            }
        )


        CurrentPage =
            Page

    end


    TabButton.MouseButton1Click:Connect(
        Select
    )


    TabButton.MouseEnter:Connect(
        function()

            if CurrentPage ~=
                Page
            then

                Tween(
                    TabButton,
                    .15,
                    {
                        BackgroundColor3 =
                            Config.Theme.Hover
                    }
                )

            end

        end
    )


    TabButton.MouseLeave:Connect(
        function()

            if CurrentPage ~=
                Page
            then

                Tween(
                    TabButton,
                    .15,
                    {
                        BackgroundColor3 =
                            Config.Theme.Secondary
                    }
                )

            end

        end
    )


    if not CurrentPage then

        task.defer(
            Select
        )

    end

