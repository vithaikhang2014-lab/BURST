--==============================================================

local function New(
    Class,
    Properties
)

    local Object =
        Instance.new(Class)

    for Property, Value in pairs(
        Properties or {}
    ) do

        pcall(function()

            Object[Property] =
                Value

        end)

    end

    return Object
end


local function Corner(
    Object,
    Radius
)

    local C =
        Instance.new("UICorner")

    C.CornerRadius =
        UDim.new(
            0,
            Radius or 10
        )

    C.Parent =
        Object

    return C
end


local function Stroke(
    Object,
    Color,
    Transparency,
    Thickness
)

    local S =
        Instance.new("UIStroke")

    S.Color =
        Color
        or
        Config.Theme.Stroke

    S.Transparency =
        Transparency
        or
        0.7

    S.Thickness =
        Thickness
        or
        1

    S.Parent =
        Object

    return S
end


local function Tween(
    Object,
    Time,
    Properties,
    Style,
    Direction
)

    local Animation =
        TweenService:Create(

            Object,

            TweenInfo.new(

                (Time or .25)
                    /
                    Config.AnimationSpeed,

                Style
                    or
                    Enum.EasingStyle.Quint,

                Direction
                    or
                    Enum.EasingDirection.Out
            ),

            Properties
        )

    Animation:Play()

    return Animation
end


local function GetParent()

    if gethui then

        local Success,
            Result =
            pcall(gethui)

        if Success and Result then
            return Result
        end

    end

    return game:GetService(
        "CoreGui"
    )
end

