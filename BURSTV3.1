--==============================================================
-- OPEN / CLOSE ANIMATION
--==============================================================

local Visible =
    true

local Animating =
    false


local function OpenUI()

    if Visible
        or
        Animating
    then

        return

    end


    Animating =
        true

    Visible =
        true


    Main.Visible =
        true


    Scale.Scale =
        .72


    Main.Position =
        UDim2.fromScale(
            .5,
            .54
        )


    Tween(
        Scale,
        .5,
        {
            Scale =
                1
        },
        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )


    Tween(
        Main,
        .5,
        {
            Position =
                UDim2.fromScale(
                    .5,
                    .5
                )
        },
        Enum.EasingStyle.Quint
    )


    task.wait(
        .45
    )


    Animating =
        false

end


local function CloseUI()

    if not Visible
        or
        Animating
    then

        return

    end


    Animating =
        true


    Tween(
        Scale,
        .12,
        {
            Scale =
                1.025
        },
        Enum.EasingStyle.Quad
    )


    task.wait(
        .06
    )


    Tween(
        Scale,
        .34,
        {
            Scale =
                .72
        },
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.In
    )


    Tween(
        Main,
        .34,
        {
            Position =
                UDim2.fromScale(
                    .5,
                    .54
                )
        },
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.In
    )


    task.wait(
        .34
    )


    Main.Visible =
        false

    Scale.Scale =
        1

    Main.Position =
        UDim2.fromScale(
            .5,
            .5
        )

    Visible =
        false

    Animating =
        false

end


local function ToggleUI()

    if Visible then

        CloseUI()

    else

        OpenUI()

    end

end

