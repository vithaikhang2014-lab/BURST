--==============================================================
-- KEYBIND
--==============================================================

UserInputService.InputBegan:Connect(
    function(
        Input,
        Processed
    )

        if Processed then
            return
        end


        if Input.KeyCode ==
            Config.ToggleKey
        then

            ToggleUI()

        end

    end
)


function Burst:SetToggleKey(
    Key
)

    if typeof(Key) ==
        "EnumItem"
    then

        Config.ToggleKey =
            Key

    end

end

--==============================================================
-- DRAG
--==============================================================

local Dragging =
    false

local DragStart

local StartPosition


Header.InputBegan:Connect(
    function(Input)

        if
            Input.UserInputType
            ==
            Enum.UserInputType.MouseButton1

            or

            Input.UserInputType
            ==
            Enum.UserInputType.Touch
        then

            Dragging =
                true

            DragStart =
                Input.Position

            StartPosition =
                Main.Position

        end

    end
)


Header.InputEnded:Connect(
    function(Input)

        if
            Input.UserInputType
            ==
            Enum.UserInputType.MouseButton1

            or

            Input.UserInputType
            ==
            Enum.UserInputType.Touch
        then

            Dragging =
                false

        end

    end
)


UserInputService.InputChanged:Connect(
    function(Input)

        if not Dragging then
            return
        end


        if
            Input.UserInputType
            ==
            Enum.UserInputType.MouseMovement

            or

            Input.UserInputType
            ==
            Enum.UserInputType.Touch
        then

            local Delta =
                Input.Position
                -
                DragStart


            Main.Position =
                UDim2.new(

                    StartPosition.X.Scale,

                    StartPosition.X.Offset
                        +
                        Delta.X,

                    StartPosition.Y.Scale,

                    StartPosition.Y.Offset
                        +
                        Delta.Y
                )

        end

    end
)

--==============================================================
-- ACCENT
--==============================================================

function Burst:SetAccent(
    Color
)

    if typeof(Color) ~=
        "Color3"
    then

        return

    end


    Config.Theme.Accent =
        Color


    AccentLine.BackgroundColor3 =
        Color

    Logo.BackgroundColor3 =
        Color

    Glow.BackgroundColor3 =
        Color

    Close.BackgroundColor3 =
        Config.Theme.Tertiary


    for _, Object in ipairs(
        ScreenGui:GetDescendants()
    ) do

        if Object:IsA(
            "UIStroke"
        ) then

            -- leave borders alone

        elseif Object:IsA(
            "TextLabel"
        ) then

            if Object.TextColor3 ==
                Config.Theme.Accent
            then

                Object.TextColor3 =
                    Color

            end

        end

    end

end

--==============================================================
-- ROUNDED CORNERS
--==============================================================

function Burst:SetCornerRadius(
    Radius
)

    Radius =
        math.clamp(
            tonumber(
                Radius
            ) or 12,

            0,
            40
        )


    for _, Object in ipairs(
        ScreenGui:GetDescendants()
    ) do

        local C =
            Object:FindFirstChildOfClass(
                "UICorner"
            )

        if C then

            C.CornerRadius =
                UDim.new(
                    0,
                    Radius
                )

        end

    end

end

