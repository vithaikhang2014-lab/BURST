                        TextSize =
                            10,

                        TextColor3 =
                            Config.Theme.SubText,

                        TextXAlignment =
                            Enum.TextXAlignment.Left
                    }
                )

            local function UpdateColor()

                CurrentColor =
                    Color3.fromHSV(
                        H,
                        S,
                        V
                    )

                Preview.BackgroundColor3 =
                    CurrentColor

                SV.BackgroundColor3 =
                    Color3.fromHSV(
                        H,
                        1,
                        1
                    )

                Cursor.Position =
                    UDim2.new(
                        S,
                        0,
                        1 - V,
                        0
                    )

                HueCursor.Position =
                    UDim2.new(
                        .5,
                        0,
                        H,
                        0
                    )

                local R =
                    math.floor(
                        CurrentColor.R
                        * 255
                    )

                local G =
                    math.floor(
                        CurrentColor.G
                        * 255
                    )

                local B =
                    math.floor(
                        CurrentColor.B
                        * 255
                    )

                RGBText.Text =
                    string.format(
                        "RGB  %d, %d, %d",
                        R,
                        G,
                        B
                    )

                if Callback then

                    task.spawn(
                        Callback,
                        CurrentColor
                    )

                end

            end

            UpdateColor()

            local SVDragging =
                false

            local HueDragging =
                false

            local function UpdateSV(
                Input
            )

                local X =
                    math.clamp(
                        Input.Position.X
                        -
                        SV.AbsolutePosition.X,

                        0,
                        SV.AbsoluteSize.X
                    )

                local Y =
                    math.clamp(
                        Input.Position.Y
                        -
                        SV.AbsolutePosition.Y,

                        0,
                        SV.AbsoluteSize.Y
                    )

                S =
                    X
                    /
                    SV.AbsoluteSize.X

                V =
                    1
                    -
                    (
                        Y
                        /
                        SV.AbsoluteSize.Y
                    )

                UpdateColor()

            end

            local function UpdateHue(
                Input
            )

                local Y =
                    math.clamp(
                        Input.Position.Y
                        -
                        Hue.AbsolutePosition.Y,

                        0,
                        Hue.AbsoluteSize.Y
                    )

                H =
                    Y
                    /
                    Hue.AbsoluteSize.Y

                UpdateColor()

            end

            SV.InputBegan:Connect(
                function(Input)

                    if
                        Input.UserInputType
                        ==
                        Enum.UserInputType.MouseButton1
                    then

                        SVDragging =
                            true

                        UpdateSV(
                            Input
                        )

                    end

                end
            )

            Hue.InputBegan:Connect(
                function(Input)

                    if
                        Input.UserInputType
                        ==
                        Enum.UserInputType.MouseButton1
                    then

                        HueDragging =
                            true

                        UpdateHue(
                            Input
                        )

                    end

                end
            )

            UserInputService.InputChanged:Connect(
                function(Input)

                    if
                        Input.UserInputType
                        ==
                        Enum.UserInputType.MouseMovement
                    then

                        if SVDragging then

                            UpdateSV(
                                Input
                            )

                        end

                        if HueDragging then

                            UpdateHue(
                                Input
                            )

                        end

                    end

                end
            )

            UserInputService.InputEnded:Connect(
                function(Input)

                    if
                        Input.UserInputType
                        ==
                        Enum.UserInputType.MouseButton1
                    then

                        SVDragging =
                            false

                        HueDragging =
                            false

                    end

                end
            )

            HeaderButton.MouseButton1Click:Connect(
                function()

                    Opened =
                        not Opened

                    Tween(
                        Container,
                        .32,
                        {
                            Size =
                                Opened

                                and
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    285
                                )

                                or
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    46
                                )
                        },
                        Enum.EasingStyle.Quint
                    )

                end
            )

            return {

                Set =
                    function(
                        _,
                        Value
                    )

                        if
                            typeof(
                                Value
                            )
                            ==
                            "Color3"
                        then

                            CurrentColor =
                                Value

                            H,
                            S,
                            V =
                                Value:ToHSV()

                            UpdateColor()

                        end

                    end,

                Get =
                    function()

                        return CurrentColor

                    end

            }

        end

        return API

    end

    return Tab

end

