            },
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        )

        Tween(
            Root,
            .48,
            {
                GroupTransparency =
                    0
            },
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        )

        task.wait(
            .5
        )

        Splash:Destroy()

        Burst:Notify(
            "BURST",
            "Welcome, "
                ..
                PlayerName
                ..
                "! 🚀",
            3
        )

    end
)

return Burst
