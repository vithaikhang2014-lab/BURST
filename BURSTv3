                true,

            TextXAlignment =
                Enum.TextXAlignment.Left
        }
    )

    local Scale =
        New(
            "UIScale",
            {
                Parent =
                    Notification,

                Scale =
                    .92
            }
        )

    Tween(
        Notification,
        .35,
        {
            GroupTransparency =
                0
        },
        Enum.EasingStyle.Quint
    )

    Tween(
        Scale,
        .4,
        {
            Scale =
                1
        },
        Enum.EasingStyle.Back
    )

    task.delay(
        Duration,
        function()

            Tween(
                Notification,
                .3,
                {
                    GroupTransparency =
                        1
                },
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.In
            )

            Tween(
                Scale,
                .3,
                {
                    Scale =
                        .9
                },
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.In
            )

            task.wait(.35)

            pcall(function()
                Notification:Destroy()
            end)

        end
    )

