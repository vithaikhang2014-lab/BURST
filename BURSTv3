function Burst:SetToggleKey(
    Key
)

    if
        typeof(Key)
        ==
        "EnumItem"

        and

        Key.EnumType
        ==
        Enum.KeyCode
    then

        Config.ToggleKey =
            Key

    end

end


function Burst:SetAccent(
    Color
)

    if typeof(Color)
        ~= "Color3"
    then
        return
    end

    Config.Theme.Accent =
        Color

    AccentLine.BackgroundColor3 =
        Color

    Logo.BackgroundColor3 =
        Color

    LogoStroke.Color =
        Color

    SplashLogo.BackgroundColor3 =
        Color

end


function Burst:Destroy()

    Visible =
        false

    Animating =
        false

    pcall(function()

        Tween(
            Root,
            .2,
            {
                GroupTransparency =
                    1
            }
        )

        task.wait(.22)

        ScreenGui:Destroy()

    end)

end

