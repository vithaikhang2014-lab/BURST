--==============================================================
-- OPEN / CLOSE SYSTEM
--==============================================================

local Visible =
    true

local Animating =
    false

local function OpenUI()

    if Visible
        or
        Animating
    then
        return
    end

    Animating =
        true

    Visible =
        true

    Root.Visible =
        true

    RootScale.Scale =
        .82

    Root.GroupTransparency =
        1

    Tween(
        RootScale,
        .55,
        {
            Scale =
                1
        },
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out
    )

    local Fade =
        Tween(
            Root,
            .42,
            {
                GroupTransparency =
                    0
            },
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        )

    Fade.Completed:Connect(
        function()

            Animating =
                false

        end
    )

end


local function CloseUI()

    if not Visible
        or
        Animating
    then
        return
    end

    Animating =
        true

    -- tiny press
    Tween(
        RootScale,
        .08,
        {
            Scale =
                1.025
        },
        Enum.EasingStyle.Quad
    )

    task.delay(
        .07,
        function()

            Tween(
                RootScale,
                .34,
                {
                    Scale =
                        .82
                },
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.In
            )

            local Fade =
                Tween(
                    Root,
                    .27,
                    {
                        GroupTransparency =
                            1
                    },
                    Enum.EasingStyle.Quint,
                    Enum.EasingDirection.In
                )

            Fade.Completed:Connect(
                function()

                    Root.Visible =
                        false

                    RootScale.Scale =
                        .82

                    Visible =
                        false

                    Animating =
                        false

                end
            )

        end
    )

end


local function ToggleUI()

    if Visible then

        CloseUI()

    else

        OpenUI()

    end

end

Burst.Open =
    OpenUI

Burst.Close =
    CloseUI

Burst.Toggle =
    ToggleUI

